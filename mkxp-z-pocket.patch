diff --git a/src/filesystem/filesystem.cpp b/src/filesystem/filesystem.cpp
index 98890ba..e1134dd 100644
--- a/src/filesystem/filesystem.cpp
+++ b/src/filesystem/filesystem.cpp
@@ -393,13 +393,15 @@ struct CacheEnumData {
 
   ~CacheEnumData() {
 #ifdef __APPLE__
-    iconv_close(nfd2nfc);
+    if (nfd2nfc != (iconv_t)-1) iconv_close(nfd2nfc);
 #endif
   }
 
   /* Converts in-place */
   void toNFC(char *inout) {
 #ifdef __APPLE__
+    /* "utf-8-mac" is Apple's own iconv's; without it (GNU libiconv on iOS) names stay as they are */
+    if (nfd2nfc == (iconv_t)-1) return;
     size_t srcSize = strlen(inout);
     size_t bufSize = sizeof(buf);
     char *bufPtr = buf;
diff --git a/src/util/encoding.h b/src/util/encoding.h
index 2cb0cae..a7cbd3b 100644
--- a/src/util/encoding.h
+++ b/src/util/encoding.h
@@ -42,6 +42,7 @@ static std::string convertString(const std::string &str, const char *charset) {
     }
     
     iconv_t cd = iconv_open("UTF-8", charset);
+    if (cd == (iconv_t)-1) return std::string(str);   /* an encoding this iconv does not know */
     
     size_t inLen = str.size();
     size_t outLen = inLen * 4;
@@ -70,6 +71,7 @@ static std::string convertStringToUtf32(const std::string &str) {
     std::string charset = getCharset(str);
     
     iconv_t cd = iconv_open("UCS-4-INTERNAL", charset.c_str());
+    if (cd == (iconv_t)-1) return std::string();
     
     size_t inLen = str.size();
     size_t outLen = inLen * 4;

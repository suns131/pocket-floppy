diff -ru src/ONScripter.cpp work/ONScripter.cpp
--- src/ONScripter.cpp	2022-07-18 10:20:30
+++ work/ONScripter.cpp	2026-11-15 01:49:04
@@ -110,7 +110,8 @@
     }
 #endif
 
-#if !defined(IOS)
+// In the app a controller is read by the app itself and reaches the game as keys: the engine does not open it too.
+#if !defined(IOS) && !defined(POCKET_FLOPPY)
 #if defined(ANDROID)
     SDL_SetHint(SDL_HINT_ACCELEROMETER_AS_JOYSTICK, "0");
 #endif
@@ -184,9 +185,17 @@
         utils::printError("Could not create window: %s\n", SDL_GetError());
         exit(-1);
     }
+#ifdef POCKET_FLOPPY
+    Uint32 render_flag = SDL_RENDERER_SOFTWARE;
+#else
     Uint32 render_flag = SDL_RENDERER_ACCELERATED;
+#endif
     if (vsync) render_flag |= SDL_RENDERER_PRESENTVSYNC;
     renderer = SDL_CreateRenderer(window, -1, render_flag);
+#ifdef POCKET_FLOPPY
+    if (renderer == NULL) utils::printError("Could not create a renderer: %s\n", SDL_GetError());
+    else { SDL_RendererInfo made; SDL_GetRendererInfo(renderer, &made); utils::printInfo("Renderer: %s\n", made.name); }
+#endif
 
     SDL_RenderSetLogicalSize(renderer, screen_width, screen_height);
     SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);

diff --git a/Engine/environ/shiori_systemaudio.mm b/Engine/environ/shiori_systemaudio.mm
new file mode 100644
index 0000000..ffbed71
--- /dev/null
+++ b/Engine/environ/shiori_systemaudio.mm
@@ -0,0 +1,162 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public License, v. 2.0.
+ * If a copy of the MPL was not distributed with this file, You can obtain one at
+ * https://mozilla.org/MPL/2.0/. */
+
+// Sound formats krkr2's own decoders don't cover (they read RIFF WAVE, Ogg Vorbis, Opus and TCWF),
+// decoded by the system's Audio Toolbox: MP3 above all (on Windows games play it through the
+// wump3 or krmp3 plug-ins), and AAC / M4A, AIFF, CAF and FLAC. The file is read through the
+// engine's own storage stream, so it works the same from an archive (data.xp3) or a folder.
+#include "shiori_environ.h"
+
+#include "tjsCommHead.h"
+#include "WaveIntf.h"
+#include "StorageIntf.h"
+#include "DebugIntf.h"
+
+#import <AudioToolbox/AudioToolbox.h>
+
+#include <mutex>
+
+namespace {
+
+struct SystemAudioFormat {
+    const tjs_char *extension;
+    AudioFileTypeID hint;
+};
+
+const SystemAudioFormat kFormats[] = {
+    {TJS_W(".mp3"), kAudioFileMP3Type},  {TJS_W(".mp2"), kAudioFileMP2Type},
+    {TJS_W(".m4a"), kAudioFileM4AType},  {TJS_W(".mp4"), kAudioFileMPEG4Type},
+    {TJS_W(".aac"), kAudioFileAAC_ADTSType}, {TJS_W(".caf"), kAudioFileCAFType},
+    {TJS_W(".aif"), kAudioFileAIFFType}, {TJS_W(".aiff"), kAudioFileAIFFType},
+    {TJS_W(".flac"), kAudioFileFLACType},
+};
+
+class SystemAudioDecoder : public tTVPWaveDecoder {
+public:
+    ~SystemAudioDecoder() override {
+        if (file_) ExtAudioFileDispose(file_);
+        if (audio_) AudioFileClose(audio_);
+        delete stream_;
+    }
+
+    bool open(const ttstr &storage, AudioFileTypeID hint) {
+        stream_ = TVPCreateStream(storage, TJS_BS_READ);
+        if (!stream_) return false;
+        size_ = stream_->GetSize();
+        if (AudioFileOpenWithCallbacks(this, readProc, nullptr, sizeProc, nullptr, hint, &audio_) != noErr) {
+            // The name may not tell the truth (an MP3 called .m4a and the like): let the system look.
+            audio_ = nullptr;
+            if (AudioFileOpenWithCallbacks(this, readProc, nullptr, sizeProc, nullptr, 0, &audio_) != noErr) {
+                audio_ = nullptr;
+                return false;
+            }
+        }
+        if (ExtAudioFileWrapAudioFileID(audio_, false, &file_) != noErr) { file_ = nullptr; return false; }
+
+        AudioStreamBasicDescription source = {};
+        UInt32 size = sizeof(source);
+        if (ExtAudioFileGetProperty(file_, kExtAudioFileProperty_FileDataFormat, &size, &source) != noErr) return false;
+        const UInt32 channels = source.mChannelsPerFrame ? source.mChannelsPerFrame : 2;
+        const double rate = source.mSampleRate > 0 ? source.mSampleRate : 44100;
+
+        AudioStreamBasicDescription client = {};
+        client.mFormatID = kAudioFormatLinearPCM;
+        client.mFormatFlags = kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked;
+        client.mSampleRate = rate;
+        client.mChannelsPerFrame = channels;
+        client.mBitsPerChannel = 16;
+        client.mBytesPerFrame = 2 * channels;
+        client.mFramesPerPacket = 1;
+        client.mBytesPerPacket = client.mBytesPerFrame;
+        if (ExtAudioFileSetProperty(file_, kExtAudioFileProperty_ClientDataFormat, sizeof(client), &client) != noErr) return false;
+
+        SInt64 frames = 0;
+        size = sizeof(frames);
+        ExtAudioFileGetProperty(file_, kExtAudioFileProperty_FileLengthFrames, &size, &frames);
+
+        format_.SamplesPerSec = (tjs_uint)rate;
+        format_.Channels = channels;
+        format_.BitsPerSample = 16;
+        format_.BytesPerSample = 2;
+        format_.TotalSamples = frames > 0 ? (tjs_uint64)frames : 0;
+        format_.TotalTime = frames > 0 ? (tjs_uint64)(frames * 1000.0 / rate) : 0;
+        format_.SpeakerConfig = 0;
+        format_.IsFloat = false;
+        format_.Seekable = true;
+        frameBytes_ = client.mBytesPerFrame;
+        return true;
+    }
+
+    void GetFormat(tTVPWaveFormat &format) override { format = format_; }
+
+    bool Render(void *buf, tjs_uint bufsamplelen, tjs_uint &rendered) override {
+        rendered = 0;
+        if (!file_) return false;
+        while (rendered < bufsamplelen) {
+            AudioBufferList list;
+            list.mNumberBuffers = 1;
+            list.mBuffers[0].mNumberChannels = format_.Channels;
+            list.mBuffers[0].mDataByteSize = (UInt32)((bufsamplelen - rendered) * frameBytes_);
+            list.mBuffers[0].mData = (uint8_t *)buf + rendered * frameBytes_;
+            UInt32 frames = bufsamplelen - rendered;
+            if (ExtAudioFileRead(file_, &frames, &list) != noErr) return false;
+            if (frames == 0) return false; // the end
+            rendered += frames;
+        }
+        return true;
+    }
+
+    bool SetPosition(tjs_uint64 samplepos) override {
+        return file_ && ExtAudioFileSeek(file_, (SInt64)samplepos) == noErr;
+    }
+
+private:
+    static OSStatus readProc(void *context, SInt64 position, UInt32 count, void *buffer, UInt32 *actual) {
+        auto *self = static_cast<SystemAudioDecoder *>(context);
+        *actual = 0;
+        if (position >= (SInt64)self->size_) return noErr;
+        // The engine's streams aren't shared between threads; the system may read from its own.
+        std::lock_guard<std::mutex> lock(self->lock_);
+        if (self->stream_->Seek(position, TJS_BS_SEEK_SET) != (tjs_uint64)position) return kAudioFileUnspecifiedError;
+        *actual = self->stream_->Read(buffer, count);
+        return noErr;
+    }
+    static SInt64 sizeProc(void *context) { return (SInt64) static_cast<SystemAudioDecoder *>(context)->size_; }
+
+    tTJSBinaryStream *stream_ = nullptr;
+    tjs_uint64 size_ = 0;
+    AudioFileID audio_ = nullptr;
+    ExtAudioFileRef file_ = nullptr;
+    tTVPWaveFormat format_ = {};
+    UInt32 frameBytes_ = 4;
+    std::mutex lock_;
+};
+
+class SystemAudioDecoderCreator : public tTVPWaveDecoderCreator {
+public:
+    tTVPWaveDecoder *Create(const ttstr &storagename, const ttstr &extension) override {
+        for (const auto &format : kFormats) {
+            if (extension != format.extension) continue;
+            auto *decoder = new SystemAudioDecoder();
+            try {
+                if (decoder->open(storagename, format.hint)) return decoder;
+            } catch (...) {
+            }
+            delete decoder;
+            TVPAddLog(TJS_W("Shiori: the system could not decode ") + storagename);
+            return nullptr;
+        }
+        return nullptr;
+    }
+};
+
+SystemAudioDecoderCreator creator;
+
+} // namespace
+
+// Called as each game starts (the engine's decoder list is built by then); added once.
+void ShioriRegisterSystemAudioDecoders() {
+    static std::once_flag once;
+    std::call_once(once, [] { TVPRegisterWaveDecoderCreator(&creator); });
+}
diff --git a/Engine/plugins/shiori_json.cpp b/Engine/plugins/shiori_json.cpp
new file mode 100644
index 0000000..1c4e232
--- /dev/null
+++ b/Engine/plugins/shiori_json.cpp
@@ -0,0 +1,397 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public License, v. 2.0.
+ * If a copy of the MPL was not distributed with this file, You can obtain one at
+ * https://mozilla.org/MPL/2.0/. */
+
+// json.dll: what KiriKiri games get from the JSON plug-in, on the engine's own types.
+//   Scripts.evalJSON(text)                    -> Dictionary / Array / value
+//   Scripts.evalJSONStorage(file[, utf8])     -> the same, read from storage (any text encoding)
+//   Scripts.saveJSON(file, value[, utf8[, newline]])
+//   Scripts.toJSONString(value[, newline])
+// The reader is lenient like the original: comments, single quotes, bare keys, '=' or '=>' after a
+// key, ';' between members and trailing commas are accepted. true/false become 1/0, null void.
+// krkr2's own json folder is only a placeholder; krkrsdl3's assumes UTF-8 strings.
+#include "tjsCommHead.h"
+#include "tjsArray.h"
+#include "tjsDictionary.h"
+#include "StorageIntf.h"
+#include "TextStream.h"
+#include "MsgIntf.h"
+#include <ncbind.hpp>
+#include <cmath>
+#include <string>
+
+#undef NCB_MODULE_NAME
+#define NCB_MODULE_NAME TJS_W("json.dll")
+
+namespace {
+
+struct Reader {
+    const tjs_char *p;
+    const tjs_char *end;
+
+    [[noreturn]] void fail(const char *what) {
+        TVPThrowExceptionMessage((ttstr(TJS_W("JSON: ")) + ttstr(what)).c_str());
+        __builtin_unreachable(); // it always throws
+    }
+
+    void space() {
+        for (;;) {
+            while (p < end && (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n' || *p == 0xFEFF)) ++p;
+            if (p + 1 < end && p[0] == '/' && p[1] == '/') {
+                while (p < end && *p != '\n') ++p;
+            } else if (p + 1 < end && p[0] == '/' && p[1] == '*') {
+                p += 2;
+                while (p + 1 < end && !(p[0] == '*' && p[1] == '/')) ++p;
+                if (p + 1 >= end) fail("comment not closed");
+                p += 2;
+            } else {
+                return;
+            }
+        }
+    }
+
+    static int hex(tjs_char c) {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+        return -1;
+    }
+
+    ttstr string() {
+        tjs_char quote = *p++;
+        std::u16string out;
+        while (p < end && *p != quote) {
+            tjs_char c = *p++;
+            if (c != '\\') { out.push_back(c); continue; }
+            if (p >= end) break;
+            c = *p++;
+            switch (c) {
+            case 'n': out.push_back('\n'); break;
+            case 't': out.push_back('\t'); break;
+            case 'r': out.push_back('\r'); break;
+            case 'b': out.push_back('\b'); break;
+            case 'f': out.push_back('\f'); break;
+            case 'u': {
+                int v = 0;
+                for (int i = 0; i < 4; i++) {
+                    int h = p < end ? hex(*p) : -1;
+                    if (h < 0) fail("bad \\u escape");
+                    v = v * 16 + h; ++p;
+                }
+                out.push_back(tjs_char(v));
+                break;
+            }
+            default: out.push_back(c);
+            }
+        }
+        if (p >= end) fail("string not closed");
+        ++p;
+        return ttstr(out.c_str());
+    }
+
+    static bool bare(tjs_char c) {
+        return c == '_' || c == '$' || (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c >= 0x80;
+    }
+
+    ttstr word() {
+        const tjs_char *s = p;
+        while (p < end && bare(*p)) ++p;
+        if (p == s) fail("unexpected character");
+        return ttstr(std::u16string(s, p - s).c_str());
+    }
+
+    tTJSVariant number() {
+        const tjs_char *s = p;
+        if (*p == '-' || *p == '+') ++p;
+        bool real = false;
+        while (p < end && ((*p >= '0' && *p <= '9') || *p == '.' || *p == 'e' || *p == 'E' ||
+                           ((*p == '-' || *p == '+') && (p[-1] == 'e' || p[-1] == 'E')))) {
+            if (*p == '.' || *p == 'e' || *p == 'E') real = true;
+            ++p;
+        }
+        std::string text;
+        for (const tjs_char *q = s; q < p; ++q) text.push_back(char(*q));
+        if (!real) {
+            errno = 0;
+            long long v = strtoll(text.c_str(), nullptr, 10);
+            if (errno == 0) return tTJSVariant(tTVInteger(v));
+        }
+        return tTJSVariant(tTVReal(strtod(text.c_str(), nullptr)));
+    }
+
+    tTJSVariant value() {
+        space();
+        if (p >= end) fail("unexpected end");
+        tjs_char c = *p;
+        if (c == '{') return object();
+        if (c == '[') return array();
+        if (c == '"' || c == '\'') return tTJSVariant(string());
+        if (c == '-' || c == '+' || (c >= '0' && c <= '9') || c == '.') return number();
+        ttstr w = word();
+        if (w == TJS_W("true")) return tTJSVariant(tTVInteger(1));
+        if (w == TJS_W("false")) return tTJSVariant(tTVInteger(0));
+        if (w == TJS_W("null") || w == TJS_W("void") || w == TJS_W("undefined")) return tTJSVariant();
+        return tTJSVariant(w);
+    }
+
+    tTJSVariant object() {
+        ++p;
+        iTJSDispatch2 *dict = TJSCreateDictionaryObject();
+        tTJSVariant result(dict, dict);
+        dict->Release();
+        for (;;) {
+            space();
+            if (p >= end) fail("object not closed");
+            if (*p == '}') { ++p; break; }
+            ttstr key = (*p == '"' || *p == '\'') ? string() : word();
+            space();
+            if (p < end && *p == ':') ++p;
+            else if (p + 1 < end && p[0] == '=' && p[1] == '>') p += 2;
+            else if (p < end && *p == '=') ++p;
+            else fail("':' expected after a key");
+            tTJSVariant v = value();
+            dict->PropSet(TJS_MEMBERENSURE, key.c_str(), nullptr, &v, dict);
+            space();
+            if (p < end && (*p == ',' || *p == ';')) { ++p; continue; }
+            if (p < end && *p == '}') { ++p; break; }
+            fail("',' or '}' expected");
+        }
+        return result;
+    }
+
+    tTJSVariant array() {
+        ++p;
+        iTJSDispatch2 *arr = TJSCreateArrayObject();
+        tTJSVariant result(arr, arr);
+        arr->Release();
+        tjs_int index = 0;
+        for (;;) {
+            space();
+            if (p >= end) fail("array not closed");
+            if (*p == ']') { ++p; break; }
+            tTJSVariant v = value();
+            arr->PropSetByNum(TJS_MEMBERENSURE, index++, &v, arr);
+            space();
+            if (p < end && (*p == ',' || *p == ';')) { ++p; continue; }
+            if (p < end && *p == ']') { ++p; break; }
+            fail("',' or ']' expected");
+        }
+        return result;
+    }
+};
+
+tTJSVariant parse(const ttstr &text) {
+    Reader r{text.c_str(), text.c_str() + text.length()};
+    tTJSVariant v = r.value();
+    return v;
+}
+
+struct Writer {
+    std::u16string out;
+    bool pretty;
+    int depth = 0;
+
+    void newline() {
+        if (!pretty) return;
+        out.push_back('\n');
+        for (int i = 0; i < depth; i++) out.append(u"  ");
+    }
+
+    void quote(const tjs_char *s) {
+        out.push_back('"');
+        for (; s && *s; ++s) {
+            tjs_char c = *s;
+            switch (c) {
+            case '"': out.append(u"\\\""); break;
+            case '\\': out.append(u"\\\\"); break;
+            case '\n': out.append(u"\\n"); break;
+            case '\r': out.append(u"\\r"); break;
+            case '\t': out.append(u"\\t"); break;
+            default:
+                if (c < 0x20) {
+                    char buf[8];
+                    snprintf(buf, sizeof buf, "\\u%04x", unsigned(c));
+                    for (char *b = buf; *b; ++b) out.push_back(tjs_char(*b));
+                } else {
+                    out.push_back(c);
+                }
+            }
+        }
+        out.push_back('"');
+    }
+
+    static bool isArray(iTJSDispatch2 *obj) {
+        return obj->IsInstanceOf(0, nullptr, nullptr, TJS_W("Array"), obj) == TJS_S_TRUE;
+    }
+    static bool isFunction(const tTJSVariant &v) {
+        if (v.Type() != tvtObject) return false;
+        iTJSDispatch2 *obj = v.AsObjectNoAddRef();
+        return obj && (obj->IsInstanceOf(0, nullptr, nullptr, TJS_W("Function"), obj) == TJS_S_TRUE ||
+                       obj->IsInstanceOf(0, nullptr, nullptr, TJS_W("Class"), obj) == TJS_S_TRUE);
+    }
+
+    class Members : public tTJSDispatch {
+    public:
+        Writer *w;
+        bool first = true;
+        explicit Members(Writer *w) : w(w) {}
+        tjs_error FuncCall(tjs_uint32, const tjs_char *, tjs_uint32 *, tTJSVariant *result, tjs_int numparams,
+                           tTJSVariant **param, iTJSDispatch2 *) override {
+            if (numparams > 2 && !(param[1]->AsInteger() & TJS_HIDDENMEMBER) && !isFunction(*param[2])) {
+                if (!first) w->out.push_back(',');
+                first = false;
+                w->newline();
+                w->quote(param[0]->GetString());
+                w->out.push_back(':');
+                if (w->pretty) w->out.push_back(' ');
+                w->value(*param[2]);
+            }
+            if (result) *result = true;
+            return TJS_S_OK;
+        }
+    };
+
+    void value(const tTJSVariant &v) {
+        switch (v.Type()) {
+        case tvtVoid: out.append(u"null"); return;
+        case tvtInteger: {
+            ttstr s = tTJSVariant(v).AsString();
+            out.append(s.c_str());
+            return;
+        }
+        case tvtReal: {
+            double d = v.AsReal();
+            if (!std::isfinite(d)) { out.append(u"null"); return; }
+            char buf[40];
+            snprintf(buf, sizeof buf, "%.17g", d);
+            for (char *b = buf; *b; ++b) out.push_back(tjs_char(*b));
+            return;
+        }
+        case tvtString: quote(v.GetString()); return;
+        case tvtOctet: out.append(u"null"); return;
+        case tvtObject: break;
+        }
+        iTJSDispatch2 *obj = v.AsObjectNoAddRef();
+        if (!obj || depth > 64) { out.append(u"null"); return; }
+        if (isArray(obj)) {
+            tTJSVariant count;
+            obj->PropGet(0, TJS_W("count"), nullptr, &count, obj);
+            tjs_int n = count.Type() == tvtVoid ? 0 : tjs_int(count.AsInteger());
+            out.push_back('[');
+            depth++;
+            for (tjs_int i = 0; i < n; i++) {
+                if (i) out.push_back(',');
+                newline();
+                tTJSVariant item;
+                obj->PropGetByNum(0, i, &item, obj);
+                value(item);
+            }
+            depth--;
+            if (n) newline();
+            out.push_back(']');
+            return;
+        }
+        out.push_back('{');
+        depth++;
+        Members *members = new Members(this);
+        tTJSVariantClosure closure(members);
+        obj->EnumMembers(TJS_IGNOREPROP, &closure, obj);
+        bool any = !members->first;
+        members->Release();
+        depth--;
+        if (any) newline();
+        out.push_back('}');
+    }
+};
+
+ttstr stringify(const tTJSVariant &v, bool pretty) {
+    Writer w;
+    w.pretty = pretty;
+    w.value(v);
+    return ttstr(w.out.c_str());
+}
+
+ttstr readText(const ttstr &name) {
+    iTJSTextReadStream *stream = TVPCreateTextStreamForRead(name, TJS_W(""));
+    ttstr text;
+    try {
+        stream->Read(text, 0);
+    } catch (...) {
+        stream->Destruct();
+        throw;
+    }
+    stream->Destruct();
+    return text;
+}
+
+void writeText(const ttstr &name, const ttstr &text, bool utf8) {
+    tTJSBinaryStream *stream = TVPCreateStream(TVPNormalizeStorageName(name), TJS_BS_WRITE);
+    try {
+        if (utf8) {
+            std::u16string wide(text.c_str());
+            std::string bytes;
+            for (size_t i = 0; i < wide.size(); i++) {
+                uint32_t c = wide[i];
+                if (c >= 0xD800 && c <= 0xDBFF && i + 1 < wide.size() && wide[i + 1] >= 0xDC00 && wide[i + 1] <= 0xDFFF) {
+                    c = 0x10000 + ((c - 0xD800) << 10) + (wide[i + 1] - 0xDC00);
+                    i++;
+                }
+                if (c < 0x80) bytes.push_back(char(c));
+                else if (c < 0x800) { bytes.push_back(char(0xC0 | (c >> 6))); bytes.push_back(char(0x80 | (c & 0x3F))); }
+                else if (c < 0x10000) { bytes.push_back(char(0xE0 | (c >> 12))); bytes.push_back(char(0x80 | ((c >> 6) & 0x3F))); bytes.push_back(char(0x80 | (c & 0x3F))); }
+                else { bytes.push_back(char(0xF0 | (c >> 18))); bytes.push_back(char(0x80 | ((c >> 12) & 0x3F))); bytes.push_back(char(0x80 | ((c >> 6) & 0x3F))); bytes.push_back(char(0x80 | (c & 0x3F))); }
+            }
+            stream->WriteBuffer(bytes.data(), bytes.size());
+        } else {
+            const unsigned char bom[2] = {0xFF, 0xFE};
+            stream->WriteBuffer(bom, 2);
+            std::u16string wide(text.c_str());
+            for (char16_t c : wide) {
+                unsigned char b[2] = {(unsigned char)(c & 0xFF), (unsigned char)(c >> 8)};
+                stream->WriteBuffer(b, 2);
+            }
+        }
+    } catch (...) {
+        delete stream;
+        throw;
+    }
+    delete stream;
+}
+
+struct Scripts {
+    static tjs_error evalJSON(tTJSVariant *result, tjs_int numparams, tTJSVariant **param, iTJSDispatch2 *) {
+        if (numparams < 1) return TJS_E_BADPARAMCOUNT;
+        tTJSVariant v = parse(param[0]->AsString());
+        if (result) *result = v;
+        return TJS_S_OK;
+    }
+    static tjs_error evalJSONStorage(tTJSVariant *result, tjs_int numparams, tTJSVariant **param, iTJSDispatch2 *) {
+        if (numparams < 1) return TJS_E_BADPARAMCOUNT;
+        tTJSVariant v = parse(readText(param[0]->AsString()));
+        if (result) *result = v;
+        return TJS_S_OK;
+    }
+    static tjs_error saveJSON(tTJSVariant *result, tjs_int numparams, tTJSVariant **param, iTJSDispatch2 *) {
+        if (numparams < 2) return TJS_E_BADPARAMCOUNT;
+        bool utf8 = numparams > 2 && param[2]->Type() != tvtVoid && param[2]->AsInteger() != 0;
+        bool pretty = numparams > 3 && param[3]->Type() != tvtVoid && param[3]->AsInteger() != 0;
+        writeText(param[0]->AsString(), stringify(*param[1], pretty), utf8);
+        if (result) result->Clear();
+        return TJS_S_OK;
+    }
+    static tjs_error toJSONString(tTJSVariant *result, tjs_int numparams, tTJSVariant **param, iTJSDispatch2 *) {
+        if (numparams < 1) return TJS_E_BADPARAMCOUNT;
+        bool pretty = numparams > 1 && param[1]->Type() != tvtVoid && param[1]->AsInteger() != 0;
+        if (result) *result = stringify(*param[0], pretty);
+        return TJS_S_OK;
+    }
+};
+
+} // namespace
+
+NCB_ATTACH_CLASS(Scripts, Scripts) {
+    RawCallback("evalJSON", &Scripts::evalJSON, TJS_STATICMEMBER);
+    RawCallback("evalJSONStorage", &Scripts::evalJSONStorage, TJS_STATICMEMBER);
+    RawCallback("saveJSON", &Scripts::saveJSON, TJS_STATICMEMBER);
+    RawCallback("toJSONString", &Scripts::toJSONString, TJS_STATICMEMBER);
+}
